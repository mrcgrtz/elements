{
  "name": "@mrcgrtz/elements",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build": "storybook build -c .storybook -o docs",
    "format": "prettier --write .",
    "lint": "npm run-script lint:css && npm run-script lint:js",
    "lint:css": "stylelint --max-warnings 0 --custom-formatter=stylelint-formatter-pretty \"./src/**/*.ts\"",
    "lint:js": "xo --max-warnings 0",
    "start": "storybook dev -p 9009",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/builder-vite": "^10.6.8",
    "@storybook/web-components-vite": "^10.6.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-istanbul": "^5.0.5",
    "date-fns": "^4.4.0",
    "eslint-plugin-storybook": "^10.6.8",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lit": "^3.3.3",
    "postcss-styled-syntax": "^0.7.4",
    "prettier": "^3.9.10",
    "storybook": "^10.6.8",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-formatter-pretty": "^4.0.1",
    "stylelint-prettier": "^5.0.3",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "xo": "^5.0.1"
  },
  "devDependencies": {
    "browserslist-config-mrcgrtz": "^1.0.1"
  }
}
